# Server Configuration
PORT=8080
ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nalakarsa
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta
DB_AUTO_MIGRATE=true

# Supabase Storage Configuration (Avatar Images)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=avatars
SUPABASE_CHAT_BUCKET=chat-attachments
SUPABASE_CHAT_MAX_FILE_SIZE=10485760

# Firebase Realtime Database Configuration (Realtime Chat)
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_SERVICE_ACCOUNT_JSON=

# JWT Configuration
JWT_SECRET=supersecretjwtkeychangeinproduction
JWT_REFRESH_SECRET=supersecretjwtrefreshkeychangeinproduction
JWT_ACCESS_EXPIRATION=31536000
JWT_REFRESH_EXPIRATION=31536000

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com
